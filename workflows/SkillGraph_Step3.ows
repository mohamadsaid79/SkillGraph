		<properties node_id="12" format="literal">{'add_type_annotations': False, 'auto_save': False, 'controlAreaVisible': True, 'filter': 'Comma-separated values (*.csv)', 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x03C\x00\x00\x01\xb2\x00\x00\x04n\x00\x00\x02U\x00\x00\x03C\x00\x00\x01\xd1\x00\x00\x04n\x00\x00\x02U\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x03C\x00\x00\x01\xd1\x00\x00\x04n\x00\x00\x02U', 'stored_name': 'killgraph_mining_input.csv', 'stored_path': 'output', '__version__': 3}</properties>
		<properties node_id="13" format="literal">{'autoFind': False, 'autoSend': True, 'classify': False, 'controlAreaVisible': True, 'filterAntecedentMax': 2, 'filterAntecedentMin': 1, 'filterConsequentMax': 1, 'filterConsequentMin': 1, 'filterKeywordsAntecedent': '', 'filterKeywordsConsequent': '', 'filterSearch': True, 'maxRules': 10000, 'minConfidence': 60, 'minSupport': 2, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\xff\xff\xff\xf8\x00\x00\x07\x7f\x00\x00\x047\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x047\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x047', '__version__': 1}</properties>
		<properties node_id="14" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\xff\xff\xff\xf8\x00\x00\x07\x7f\x00\x00\x047\x00\x00\x02&amp;\x00\x00\x00\xe7\x00\x00\x05I\x00\x00\x03&gt;\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x047', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, DiscreteVariable\n\nout_data = None\nout_learner = None\nout_classifier = None\nout_object = None\n\nif in_data is not None:\n    attributes = in_data.domain.attributes\n\n    # Each skill has only one item: present.\n    skill_variables = [\n        DiscreteVariable(var.name, values=("Present",))\n        for var in attributes\n    ]\n\n    matrix = np.full(\n        (len(in_data), len(attributes)), np.nan\n    )\n\n    for index, var in enumerate(attributes):\n        if not var.is_discrete or "1" not in var.values:\n            raise ValueError(\n                f"Expected a binary skill column: {var.name}"\n            )\n\n        present_code = var.values.index("1")\n        detected = in_data.get_column(var) == present_code\n        matrix[detected, index] = 0\n\n    domain = Domain(\n        skill_variables,\n        metas=in_data.domain.metas\n    )\n\n    out_data = Table.from_numpy(\n        domain,\n        matrix,\n        metas=in_data.metas.copy()\n    )\n\n    print("Transactions:", len(out_data))\n    print("Skill features:", len(domain.attributes))\n    print("Ready for presence-only association rules.")', 'filename': None}], 'scriptText': 'import numpy as np\nfrom Orange.data import Table, Domain, DiscreteVariable\n\nout_data = None\nout_learner = None\nout_classifier = None\nout_object = None\n\nif in_data is not None:\n    attributes = in_data.domain.attributes\n\n    # Each skill has only one item: present.\n    skill_variables = [\n        DiscreteVariable(var.name, values=("Present",))\n        for var in attributes\n    ]\n\n    matrix = np.full(\n        (len(in_data), len(attributes)), np.nan\n    )\n\n    for index, var in enumerate(attributes):\n        if not var.is_discrete or "1" not in var.values:\n            raise ValueError(\n                f"Expected a binary skill column: {var.name}"\n            )\n\n        present_code = var.values.index("1")\n        detected = in_data.get_column(var) == present_code\n        matrix[detected, index] = 0\n\n    domain = Domain(\n        skill_variables,\n        metas=in_data.domain.metas\n    )\n\n    out_data = Table.from_numpy(\n        domain,\n        matrix,\n        metas=in_data.metas.copy()\n    )\n\n    print("Transactions:", len(out_data))\n    print("Skill features:", len(domain.attributes))\n    print("Ready for presence-only association rules.")', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x94\x00\x00\x00R\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
