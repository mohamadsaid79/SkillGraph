		<properties node_id="7" format="literal">{'add_type_annotations': False, 'auto_save': False, 'controlAreaVisible': True, 'filter': 'Comma-separated values (*.csv)', 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x02\x80\x00\x00\x02\x8e\x00\x00\x03\xa0\x00\x00\x03R\x00\x00\x02\x80\x00\x00\x02\xad\x00\x00\x03\xa0\x00\x00\x03R\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x02\x80\x00\x00\x02\xad\x00\x00\x03\xa0\x00\x00\x03R', 'stored_name': 'skillgraph_jobs_clean.csv', 'stored_path': 'output', '__version__': 3}</properties>
		<properties node_id="8" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x00\xff\xff\xff\xf8\x00\x00\x07\x7f\x00\x00\x047\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x047\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x047', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': 'import re\nimport html\nimport numpy as np\nfrom Orange.data import Table, Domain, DiscreteVariable, StringVariable\n\nout_data = None\nout_learner = None\nout_classifier = None\nout_object = None\n\nif in_data is None:\n    print("Connect Unique to Python Script first.")\nelse:\n    # Skill names and alternative spellings.\n    skill_patterns = {\n        "Python": r"\\bpython\\b",\n        "Java": r"\\bjava\\b",\n        "JavaScript": r"\\bjava\\s*script\\b",\n        "TypeScript": r"\\btypescript\\b",\n        "C++": r"(?&lt;!\\w)c\\+\\+(?!\\w)",\n        "C#": r"(?&lt;!\\w)c#(?!\\w)|\\bc\\s*sharp\\b",\n        "PHP": r"\\bphp\\b",\n        "SQL": r"\\bsql\\b",\n        "MySQL": r"\\bmysql\\b",\n        "PostgreSQL": r"\\bpostgres(?:ql)?\\b",\n        "MongoDB": r"\\bmongo\\s*db\\b",\n        "HTML": r"\\bhtml5?\\b",\n        "CSS": r"\\bcss3?\\b",\n        "React": r"\\breact(?:\\.?js)?\\b",\n        "Angular": r"\\bangular(?:\\.?js)?\\b",\n        "Node.js": r"\\bnode[.\\s]*js\\b",\n        "Django": r"\\bdjango\\b",\n        "Laravel": r"\\blaravel\\b",\n        ".NET": r"(?&lt;!\\w)\\.net\\b|\\bdot\\s*net\\b",\n        "Linux": r"\\blinux\\b",\n        "Git": r"\\bgit\\b",\n        "Docker": r"\\bdocker\\b",\n        "Kubernetes": r"\\bkubernetes\\b|\\bk8s\\b",\n        "AWS": r"\\baws\\b|\\bamazon web services\\b",\n        "Azure": r"\\bazure\\b",\n        "Jenkins": r"\\bjenkins\\b",\n        "Ansible": r"\\bansible\\b",\n        "Terraform": r"\\bterraform\\b",\n        "Hadoop": r"\\bhadoop\\b",\n        "Spark": r"\\b(?:apache\\s+)?spark\\b",\n    }\n\n    names = list(skill_patterns)\n    patterns = [\n        re.compile(skill_patterns[name], re.IGNORECASE)\n        for name in names\n    ]\n\n    descriptions = in_data.get_column("jobdescription")\n    matrix = np.zeros((len(in_data), len(names)), dtype=float)\n    extracted = []\n\n    for i, description in enumerate(descriptions):\n        text = description if isinstance(description, str) else ""\n        text = html.unescape(text)\n\n        # Exclude the company profile to reduce unrelated mentions.\n        text = re.split(\n            r"\\bcompany\\s+profile\\s*:",\n            text,\n            maxsplit=1,\n            flags=re.IGNORECASE\n        )[0]\n\n        text = re.sub(r"&lt;[^&gt;]+&gt;", " ", text)\n        text = re.sub(r"\\s+", " ", text).strip()\n\n        found = []\n        for j, pattern in enumerate(patterns):\n            if pattern.search(text):\n                matrix[i, j] = 1\n                found.append(names[j])\n\n        extracted.append("; ".join(found))\n\n    # Keep the original metadata and add a readable skills list.\n    variables = [\n        DiscreteVariable(name, values=("0", "1"))\n        for name in names\n    ]\n\n    meta_variables = list(in_data.domain.metas)\n    meta_variables.append(StringVariable("extracted_skills"))\n\n    metas = np.column_stack((\n        in_data.metas,\n        np.asarray(extracted, dtype=object)\n    ))\n\n    domain = Domain(variables, metas=meta_variables)\n    out_data = Table.from_numpy(domain, matrix, metas=metas)\n\n    print("Input rows:", len(in_data))\n    print("Output rows:", len(out_data))\n    print("Skill features:", len(names))\n    print("Rows with detected skills:", int((matrix.sum(axis=1) &gt; 0).sum()))\n    print("Rows without detected skills:", int((matrix.sum(axis=1) == 0).sum()))\n\n    print("\\nSkill mention counts:")\n    for name, count in sorted(\n        zip(names, matrix.sum(axis=0)),\n        key=lambda item: item[1],\n        reverse=True\n    ):\n        print(f"{name}: {int(count)}")', 'splitterState': b"\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x03'\x00\x00\x00\xb1\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00", 'vimModeEnabled': False, '__version__': 2}</properties>
